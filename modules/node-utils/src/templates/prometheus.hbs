scrape_configs:
{{#each nodes}}
    - job_name: '{{this.job_name}}'
      scrape_interval: 5s
      static_configs:
        - targets: ['{{this.node}}:{{this.port}}']

{{/each}}
    - job_name: '{{host_job_name}}'
      scrape_interval: 15s
      static_configs:
        - targets: ['node-exporter:9100']
