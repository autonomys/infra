            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (compose_service) (count_over_time({compose_project=~\"auto-drive|file-retriever\", host=~\"auto-drive|auto-drive-gateway|ip-10-0-10[1-3]-[0-9]+\", host=~\"$host\", compose_service=~\"$service\", compose_service!=\"agent\"} |~ `(?i)$search` [$__auto]))",
