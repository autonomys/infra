# Rendered by Terraform from modules/auto-drive-backend-host, after
# nginx/backend.mainnet.private.conf in autonomys/auto-drive, with the hostnames,
# ports and certificate paths as inputs.
%{ if !tls ~}
# Port 80 only, until the certificate exists: certbot's nginx authenticator
# answers its challenges through these server blocks.

server {
    listen 80;
    server_name ${join(" ", compact([app_host, auth_host]))};

    location / {
        return 404;
    }
}
%{ else ~}

server {
    root /var/www/html;
    index index.html index.htm index.nginx-debian.html;

    server_name ${app_host};

    location /hasura {
        proxy_buffering off;
        proxy_pass http://${upstream}:${hasura_port};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        rewrite /hasura/(.*) /$1  break;
    }

    location /api {
        proxy_buffering off;
        proxy_pass http://${upstream}:${api_port};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;

        add_header 'Access-Control-Allow-Origin' '*' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization,X-Auth-Provider,X-Auto-Sdk-Version' always;
        add_header 'Access-Control-Expose-Headers' 'Content-Length,Content-Range' always;
        add_header 'Access-Control-Max-Age' '3600' always;
        add_header 'Access-Control-Allow-Credentials' 'true' always;

        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin' '*' always;
            add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, OPTIONS' always;
            add_header 'Access-Control-Allow-Headers' 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization,X-Auth-Provider,X-Auto-Sdk-Version' always;
            add_header 'Access-Control-Max-Age' 1728000 always;
            add_header 'Content-Type' 'text/plain charset=UTF-8' always;
            add_header 'Content-Length' 0 always;
            return 204;
        }
        rewrite /api/(.*) /$1  break;
    }

    listen 443 ssl http2;
    ssl_certificate /etc/letsencrypt/live/${cert_name}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${cert_name}/privkey.pem;
}
%{ if auth_host != null ~}

# The auth service, which production runs behind an API gateway instead
server {
    server_name ${auth_host};
%{ if !auth_onboarding ~}

    # Onboarding is what lets an account upload, so it is not offered here: it
    # answers only on the auth port itself. nginx matches the decoded path, in
    # any case, which covers every spelling the app's router accepts.
    location ~* ^/users/@me/onboard {
        return 403;
    }
%{ endif ~}

    location / {
        proxy_buffering off;
        proxy_pass http://${upstream}:${auth_port};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
    }

    listen 443 ssl http2;
    ssl_certificate /etc/letsencrypt/live/${cert_name}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${cert_name}/privkey.pem;
}

server {
    if ($host = ${auth_host}) {
        return 301 https://$host$request_uri;
    }

    server_name ${auth_host};
    listen 80;
    return 404;
}
%{ endif ~}

server {
    if ($host = ${app_host}) {
        return 301 https://$host$request_uri;
    }

    server_name ${app_host};
    listen 80;
    return 404;
}
%{ endif ~}
